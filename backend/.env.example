# Copiar este archivo como .env y rellenar los valores reales
# NUNCA subir .env al repositorio

# ── Telegram ─────────────────────────────────────────────────────────────────
# Token por empresa — obtener en @BotFather. Si falta, ese bot se omite.
TELEGRAM_BOT_TOKEN_FIBRATEC=your_fibratec_bot_token_here
TELEGRAM_BOT_TOKEN_COMPUSEMMM=your_compusemmm_bot_token_here

# URL pública HTTPS donde corre el servidor (sin barra al final).
# Si se define, los bots usan webhook en lugar de polling — RECOMENDADO en producción.
# Desarrollo con ngrok:   TELEGRAM_WEBHOOK_URL=https://abc123.ngrok.io
# Producción:             TELEGRAM_WEBHOOK_URL=https://api.tudominio.com
# Dejar vacío para usar polling (desarrollo sin HTTPS):
TELEGRAM_WEBHOOK_URL=

# ── Meta (WhatsApp / Facebook / Instagram) ────────────────────────────────────
# App Secret de la app en developers.facebook.com → Configuración → Básica → App Secret
# Se usa para validar la firma HMAC-SHA256 de cada webhook entrante.
META_APP_SECRET=your_meta_app_secret_here

# Token de verificación del webhook (lo defines tú, debe coincidir con el panel de Meta)
META_WEBHOOK_VERIFY_TOKEN=isp_chatbot_meta_verify

# Credenciales por empresa — dejar vacíos los que no apliquen
META_FIBRATEC_ACCESS_TOKEN=your_fibratec_access_token_here
META_FIBRATEC_WHATSAPP_PHONE_ID=your_fibratec_whatsapp_phone_id_here
META_FIBRATEC_FACEBOOK_PAGE_ID=your_fibratec_facebook_page_id_here
META_FIBRATEC_INSTAGRAM_ID=your_fibratec_instagram_id_here

META_COMPUSEMMM_ACCESS_TOKEN=your_compusemmm_access_token_here
META_COMPUSEMMM_WHATSAPP_PHONE_ID=your_compusemmm_whatsapp_phone_id_here
META_COMPUSEMMM_FACEBOOK_PAGE_ID=your_compusemmm_facebook_page_id_here
META_COMPUSEMMM_INSTAGRAM_ID=your_compusemmm_instagram_id_here

# ── Base de datos PostgreSQL ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=isp_chatbot
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens (mínimo 32 caracteres en producción)
JWT_SECRET=your_super_secret_key_here
# Duración de la sesión (10h = un turno laboral, 24h = un día completo)
JWT_EXPIRY=10h

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3009

# URL del frontend para CORS (en producción: https://crm.tudominio.com)
FRONTEND_URL=http://localhost:3000
