# ── Dependencias ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build / Producción ────────────────────────────────────────────────────────
/frontend/build
/backend/dist

# ── Variables de entorno (NUNCA subir — contienen tokens y contraseñas) ───────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Env específicos de frontend (pueden contener URLs de producción)
.env.development
.env.production

# ── Archivos subidos por usuarios (avatares, media, audio) ────────────────────
backend/uploads/
uploads/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Logs de PM2 (se generan en tiempo de ejecución en el servidor)
backend/logs/

# ── IDEs y editores ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Claude Code (memoria y configuración local del agente IA) ────────────────
.claude/

# ── Sistema operativo ─────────────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# ── Base de datos — solo ignorar backups y scripts ad-hoc ────────────────────
# Las migraciones en backend/src/config/migrations/ SÍ se suben
database_backup.sql
migrate_*.js
debug_*.js
inspect_*.js
fix_*.js

# ── Documentación interna / archivos de gestión ──────────────────────────────
guia-despliegue-produccion.pdf
PENDIENTES.md

# ── Otros ────────────────────────────────────────────────────────────────────
*.tgz
.npm
.eslintcache
